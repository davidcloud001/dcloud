# GitHub Configuration (davidcloud001 account)
# Never put real tokens here. Use personal access tokens with appropriate scopes when developing locally.
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_OWNER=davidcloud001
GITHUB_TARGET_REPO=dcloud

# AI Assistant Configuration
# Get your API key from the respective provider dashboards.
# Never expose this in frontend code.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
